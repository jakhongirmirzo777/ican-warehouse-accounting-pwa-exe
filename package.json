{
  "name": "ican-warehouse-accounting",
  "version": "1.0.14",
  "description": "ICan warehouse system",
  "main": "main.js",
  "author": "Jakhongirmirzo Tursunaliev",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0 <18.0.0",
    "npm": ">=7.10.0 <8.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jakhongirmirzo777/ican-warehouse-accounting-pwa-exe"
  },
  "scripts": {
    "dev": "vite --open",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "lint-staged",
    "prepare": "husky install",
    "docker:up": "docker-compose up",
    "docker:down": "docker-compose down",
    "update:version": "npm version patch",
    "electron:build": "npm run build && electron-builder --win",
    "electron:publish": "set GH_TOKEN=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 && npm run update:version && npm run build && electron-builder --win --publish always"
  },
  "dependencies": {
    "@vee-validate/rules": "^4.5.11",
    "axios": "^0.27.2",
    "crypto-js": "^4.1.1",
    "electron-is-dev": "^2.0.0",
    "electron-updater": "^5.3.0",
    "element-plus": "^2.2.16",
    "maska": "^1.5.0",
    "vee-validate": "^4.5.11",
    "vue": "^3.2.36",
    "vue-i18n": "^9.1.10",
    "vue-router": "^4.0.15"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.1.0",
    "@types/crypto-js": "^4.1.1",
    "@types/node": "^16.11.45",
    "@vitejs/plugin-vue": "^3.0.1",
    "@vue/eslint-config-prettier": "^7.0.0",
    "@vue/eslint-config-typescript": "^11.0.0",
    "@vue/tsconfig": "^0.1.3",
    "electron": "^22.1.0",
    "electron-builder": "^23.6.0",
    "eslint": "^8.5.0",
    "eslint-plugin-vue": "^9.0.0",
    "husky": "^8.0.1",
    "lint-staged": "^13.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.5.1",
    "sass": "^1.52.3",
    "sass-loader": "^13.0.0",
    "typescript": "~4.7.4",
    "unplugin-element-plus": "^0.4.1",
    "validate-branch-name": "^1.3.0",
    "vite": "^3.0.1",
    "vite-plugin-pwa": "^0.12.0",
    "vite-svg-loader": "^3.4.0",
    "vue-tsc": "^0.38.8"
  },
  "build": {
    "appId": "com.ican-warehouse-accounting.app",
    "productName": "iCAN-warehouse-accounting",
    "target": "NSIS",
    "directories": {
      "output": "electron-build",
      "buildResources": "build-assets"
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "oneClick": false
    },
    "win": {
      "publish": [
        "github"
      ]
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "eslint --quiet",
      "git add"
    ]
  },
  "validate-branch-name": {
    "pattern": "^(master|dev|production|credit-production|credit-dev|pwa-exe){1}$|^(feature|fix|bug)\\/.+",
    "errorMsg": "The branch name should be master|dev or it should start with feature|fix|bug. For example, feature/{branch-name}"
  }
}
