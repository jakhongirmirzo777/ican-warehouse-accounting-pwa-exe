{
  "name": "vue-project",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "lint-staged",
    "prepare": "husky install",
    "docker:up:local": "docker-compose up local",
    "docker:up:staging": "docker-compose up staging",
    "docker:up:production": "docker-compose up production",
    "docker:down:local": "docker-compose rm -f -s -v local",
    "docker:down:staging": "docker-compose rm -f -s -v staging",
    "docker:down:production": "docker-compose rm -f -s -v production"
  },
  "dependencies": {
    "@vee-validate/rules": "^4.5.11",
    "axios": "^0.27.2",
    "element-plus": "^2.2.16",
    "maska": "^1.5.0",
    "vee-validate": "^4.5.11",
    "vue": "^3.2.36",
    "vue-i18n": "^9.1.10",
    "vue-router": "^4.0.15"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.1.0",
    "@types/node": "^16.11.45",
    "@vitejs/plugin-vue": "^3.0.1",
    "@vue/eslint-config-prettier": "^7.0.0",
    "@vue/eslint-config-typescript": "^11.0.0",
    "@vue/tsconfig": "^0.1.3",
    "eslint": "^8.5.0",
    "eslint-plugin-vue": "^9.0.0",
    "husky": "^8.0.1",
    "lint-staged": "^13.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.5.1",
    "sass": "^1.52.3",
    "sass-loader": "^13.0.0",
    "typescript": "~4.7.4",
    "unplugin-element-plus": "^0.4.1",
    "validate-branch-name": "^1.3.0",
    "vite": "^3.0.1",
    "vite-plugin-pwa": "^0.12.0",
    "vite-svg-loader": "^3.4.0",
    "vue-tsc": "^0.38.8"
  },
  "lint-staged": {
    "*.js": ["eslint --quiet", "git add"],
    "*.ts": ["eslint --quiet", "git add"],
    "*.vue": ["eslint --quiet", "git add"]
  },
  "validate-branch-name": {
    "pattern": "^(master|dev){1}$|^(feature|fix|bug)\\/.+",
    "errorMsg": "The branch name should be master|dev or it should start with feature|fix|bug. For example, feature/{branch-name}"
  }
}
